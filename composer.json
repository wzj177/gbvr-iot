  "require": {
    "php": ">=8.2",
    "workerman/webman-framework": "~2.1",
    "monolog/monolog": "^2.0",
    "webman/console": "^1.2",
    "workerman/crontab": "^1.0",
    "vlucas/phpdotenv": "^5.4",
    "davedevelopment/phpmig": "^1.7",
    "doctrine/annotations": "^2.0",
    "webman/redis-queue": "~2.1",
    "psr/container": "^1.1.1",
    "workerman/globaldata": "^1.0",
    "ramsey/uuid": "^4.2",
    "imagine/imagine": "^1.3",
    "gregwar/captcha": "^1.1",
    "pimple/pimple": "^3.5",
    "doctrine/dbal": "^3.3",
    "doctrine/common": "^3.4",
    "doctrine/lexer": "^2.1",
    "symfony/lock": "^5.4",
