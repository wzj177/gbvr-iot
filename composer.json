{
  "name": "wanzij/gbvr",
  "type": "project",
  "keywords": [
    "GB28181",
    "exosip2",
    "webman",
    "workerman"
  ],
  "homepage": "https://wanzij.cn",
  "license": "MIT",
  "description": "基于php-exosip2 + webman 实现的国标视频管理平台",
  "authors": [
    {
      "name": "wanzij",
      "email": "wanzij177@163.com",
      "homepage": "https://wanzij.cn",
      "role": "Developer"
    }
  ],
  "support": {
    "email": "wanzij177@163.com"
  },
  "require": {
    "php": ">=8.2",
    "workerman/webman-framework": "~2.1",
    "monolog/monolog": "^2.0",
    "webman/console": "^1.2",
    "workerman/crontab": "^1.0",
    "vlucas/phpdotenv": "^5.4",
    "davedevelopment/phpmig": "^1.7",
    "doctrine/annotations": "^2.0",
    "webman/redis-queue": "~2.1",
    "psr/container": "^1.1.1",
    "workerman/globaldata": "^1.0",
    "ramsey/uuid": "^4.2",
    "imagine/imagine": "^1.3",
    "gregwar/captcha": "^1.1",
    "pimple/pimple": "^3.5",
    "doctrine/dbal": "^3.3",
    "doctrine/common": "^3.4",
    "doctrine/lexer": "^2.1",
    "symfony/lock": "^5.4",
    "symfony/event-dispatcher": "^5.4",
    "symfony/finder": "^5.4",
    "symfony/stopwatch": "^5.4",
    "symfony/security-acl": "^3.3",
    "phpoffice/phpspreadsheet": "^1.25",
    "twig/twig": "^3.5",
    "swiftmailer/swiftmailer": "^6.3",
    "webman/captcha": "^1.0",
    "firebase/php-jwt": "^6.4",
    "workerman/validation": "^3.0",
    "ext-openssl": "*",
    "ext-json": "*",
    "workerman/workerman": "~5.1",
    "webman/log": "~2.1",
    "webman/redis": "^2.1",
    "illuminate/events": "^12.39",
    "guzzlehttp/guzzle": "^7.10",
    "symfony/process": "^5.4",
    "qiniu/php-sdk": "^7.14",
    "aliyuncs/oss-sdk-php": "^2.7",
    "php-ffmpeg/php-ffmpeg": "^1.3",
    "ext-redis": "*",
    "php-amqplib/php-amqplib": "^3.7"
  },
  "suggest": {
    "ext-event": "For better performance. "
  },
  "autoload": {
    "psr-4": {
      "": "./",
      "app\\": "./app",
      "App\\": "./app",
      "app\\View\\Components\\": "./app/view/components",
      "CoreW\\": "./CoreW",
      "Gb28181\\GateWay\\": "./Gb28181Gateway/src"
    },
    "files": [
      "./support/helpers.php",
      "./support/ExtendHelper.php"
    ]
  },
  "scripts": {
    "post-package-install": [
      "support\\Plugin::install"
    ],
    "post-package-update": [
      "support\\Plugin::install"
    ],
    "pre-package-uninstall": [
      "support\\Plugin::uninstall"
    ]
  },
  "require-dev": {
    "symfony/var-dumper": "^5.4"
  }
}
