server {
    listen 80;
    server_name vr.wanzij.cn;
    index index.html index.php;

    # 配置 VR 前端
    location / {
        root /path/to/vue-pc-frontend;  # 请替换为你的 VR 前端静态文件目录
        try_files $uri $uri/ /index.html;
    }

    location /design {
        root /path/to/vue-pc-design;  # 请替换为你的 VR 前端静态文件目录
        try_files $uri $uri/ /design/index.html;
    }
    location /system {
        root /path/to/vue-pc-system;  # 请替换为你的 VR 前端静态文件目录
        try_files $uri $uri/ /system/index.html;
    }

    # 配置装修平台接口
    location /service {
        proxy_pass http://127.0.0.1:8787;  # 请替换为你的装修平台接口地址
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 其他配置...
}
