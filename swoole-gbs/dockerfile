FROM php:8.4-cli

# Swoole 编译依赖 + posix/pcntl（master 监督进程信号处理 / CommandSubscriber 优雅退出）
RUN apt-get update && apt-get install -y \
    libpcre2-dev \
    libssl-dev \
    zlib1g-dev \
    libcurl4-openssl-dev \
    libc-ares-dev \
    autoconf \
    build-essential \
    git \
    unzip \
    && rm -rf /var/lib/apt/lists/*

RUN docker-php-ext-install pcntl posix

# 钉版本安装 Swoole 6.6（代码使用 Coroutine\Lock，需 >= 6.6；失败则回退 pecl 最新版）
ARG SWOOLE_VERSION=6.6.0
RUN pecl install -D 'enable-openssl="yes" enable-swoole-curl="yes" enable-swoole-json="no"' swoole-${SWOOLE_VERSION} \
    || pecl install -D 'enable-openssl="yes" enable-swoole-curl="yes" enable-swoole-json="no"' swoole \
    && docker-php-ext-enable swoole

WORKDIR /app
