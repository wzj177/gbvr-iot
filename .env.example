APP_DEBUG=1
APP_NAME='EasyVR'

SERVER_PROCESS_GROUP=''
SERVER_PROCESS_USER=''

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE='vr_diy'
DB_USERNAME=root
DB_PASSWORD=root
DB_PREFIX=vr_

SESSION_DRIVER=file

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# token存储方式：db | redis
TOKEN_STORAGE='db'
# 管理端接口认证方式：default=单token认证 jwt=jwt认证
ADMIN_AUTH_TOKEN_HANDLER='default'
# 会员端接口认证方式：default=单token认证 jwt=jwt认证
API_AUTH_TOKEN_HANDLER='default'
OAUTH2_QQ_OPEN=false
OAUTH2_QQ_KEY=
OAUTH2_QQ_SECRET=

#JWT Authentication Secret
JWT_SECRET=''
JWT_PUBLIC_KEY=''
JWT_PRIVATE_KEY=''
# 单位：分钟
JWT_TTL=60
# 单位：分钟
JWT_REFRESH_TTL=null
# 支持：HS256 RS256
JWT_ALGO=RS256
JWT_LEEWAY=0
JWT_BLACKLIST_ENABLED=true

# 音视频处理
FFMPEG_BIN=/usr/local/bin/ffmpeg
FFPROBE_BIN=/usr/local/bin/ffprobe
FFMPEG_TIMEOUT=3600
FFMPEG_THREADS=12

# 文件分段下载，download.php 允许来源访问白名单(多个 url 以英文｜分割)
BIG_FILE_DOWNLOAD_REFERER_WHITE_LIST=''

# 装修平台url
DESIGN_SITE_URL = 'http://vr2.boyuntong.com/design'
# vr前端url
PC_SITE_URL = 'http://vr2.boyuntong.com'
# vr后端url
ADMIN_SITE_URL = 'http://vr2.boyuntong.com/system'


